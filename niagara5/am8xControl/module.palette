<?xml version="1.0" encoding="UTF-8"?>
<bajaObjectGraph version="4.0" reversibleEncodingKeySource="none" FIPSEnabled="false" reversibleEncodingValidator="[null.1]=" >
<!-- UnrestrictedFolder, NON Folder: BTagDictionary.isParentLegal() accetta solo un
     TagDictionaryService e BHierarchy.isParentLegal() solo un HierarchyService, quindi
     dentro un b:Folder normale il decoder della palette rifiuta l'add e l'INTERA palette
     va in errore ("Illegal parent baja:Folder for child ..."). UnrestrictedFolder salta
     il controllo di legalita' del parent ed e' quello che usano le palette Tridium che
     spediscono tag dictionary e hierarchy (cfr. brick-rt, analytics-lib-ux, micros-wb). -->
<p m="b=baja" t="b:UnrestrictedFolder">
    <p m="am8x2=am8xControl" t="am8x2:Am8xImportService" n="Am8xImportService" />
    <!-- Trascinare in Services/TagDictionaryService per abilitare i tag am8x:*.
         I tag sono calcolati, non scritti: funzionano anche sugli alberi
         importati con versioni precedenti del modulo. -->
    <p m="am8x2=am8xControl" t="am8x2:Am8xTagDictionary" n="Am8xTagDictionary" />

    <!-- Trascinare in Services/HierarchyService. Richiede che Am8xTagDictionary
         sia gia' installato in Services/TagDictionaryService, altrimenti i tag
         am8x:* non esistono e le hierarchy restano vuote.

         scope e' obbligatorio: senza almeno un HierarchyScope con scopeOrd la
         hierarchy non interroga nulla e resta silenziosamente vuota (verificato
         su QueryUtil.resolveQueryOnScopes: con BHierarchyScope[] vuoto il ciclo
         sulle scope non esegue nessuna query). "station:|slot:/Drivers" limita
         la ricerca al sottoalbero dove vive il driver Modbus con i device am8x,
         evitando di scandire inutilmente Services, History e l'albero allarmi. -->

    <!-- ATTENZIONE - punti senza zona: am8x:zone viene emesso da
         BAm8xTagDictionary solo se zoneAddress non e' vuoto (tag condizionale,
         vedi BAm8xTagDictionary.implied). Un punto con am8x:kind ma senza
         indirizzo di zona non puo' essere collocato dal livello 'livelloZona'
         qui sotto e quindi NON COMPARE in nessuna delle due hierarchy, in modo
         silenzioso (nessun errore, nessun fault). Resta comunque raggiungibile
         normalmente nell'albero del driver Modbus. Non abbiamo introdotto un
         livello "senza zona" di raccolta perche' non sappiamo ancora quanto
         sia comune questo caso sui dati reali importati: da verificare nel
         collaudo su VM prima di decidere se serve una tale variante. -->

    <!-- CONSIGLIATA con piu' centrali: i numeri di zona si ripetono fra centrali,
         e una gerarchia zona-first le fonderebbe in un nodo solo. -->
    <p m="hierarchy=hierarchy" t="hierarchy:Hierarchy" n="AM8x_PerCentrale">
      <p n="scope" t="hierarchy:HierarchyScopeContainer">
        <p n="Station" t="hierarchy:HierarchyScope">
          <p n="scopeOrd" t="b:Ord" v="station:|slot:/Drivers" />
        </p>
      </p>
      <p n="livelloPanel" t="hierarchy:GroupLevelDef">
        <p n="groupBy" t="b:String" v="am8x:panel" />
      </p>
      <p n="livelloLoop" t="hierarchy:GroupLevelDef">
        <p n="groupBy" t="b:String" v="am8x:loop" />
      </p>
      <p n="livelloZona" t="hierarchy:GroupLevelDef">
        <p n="groupBy" t="b:String" v="am8x:zone" />
      </p>
      <p n="foglie" t="hierarchy:QueryLevelDef">
        <p n="query" t="b:String" v="am8x:kind" />
      </p>
    </p>

    <!-- Variante piatta per impianto a centrale singola, dove il livello
         'centrale' aggiungerebbe solo un nodo inutile.

         ATTENZIONE - punti senza zona: vedi la nota sopra su AM8x_PerCentrale,
         valida identicamente qui: un punto con am8x:kind ma senza
         am8x:zone non compare in questa hierarchy. -->
    <p m="hierarchy=hierarchy" t="hierarchy:Hierarchy" n="AM8x_PerZona">
      <p n="scope" t="hierarchy:HierarchyScopeContainer">
        <p n="Station" t="hierarchy:HierarchyScope">
          <p n="scopeOrd" t="b:Ord" v="station:|slot:/Drivers" />
        </p>
      </p>
      <p n="livelloZona" t="hierarchy:GroupLevelDef">
        <p n="groupBy" t="b:String" v="am8x:zone" />
      </p>
      <p n="foglie" t="hierarchy:QueryLevelDef">
        <p n="query" t="b:String" v="am8x:kind" />
      </p>
    </p>
</p>
</bajaObjectGraph>
